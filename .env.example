# Copy this file to .env.local and fill in values for your machine.
# .env.local is git-ignored. Never commit real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time. Never put secrets in a NEXT_PUBLIC_ variable.

# ---------------------------------------------------------------------------
# App (Phase 1)
# ---------------------------------------------------------------------------

# Absolute public URL of the site, no trailing slash. Used for canonical URLs,
# Open Graph metadata, robots.txt and sitemap.xml.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Flight data (Phase 3) - server-only, never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Which provider powers /flights: "mock" (local sample data, default) or
# "duffel" (Duffel API v2 test mode).
FLIGHTS_PROVIDER=mock

# Duffel test-mode access token, required when FLIGHTS_PROVIDER=duffel.
# Create one in the Duffel dashboard (Developers > Access tokens) with
# test mode switched on. Only tokens starting with "duffel_test_" are
# accepted; live tokens are rejected on purpose.
DUFFEL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Reserved for later phases. Not read by the app yet; leave commented out.
# ---------------------------------------------------------------------------

# Database and auth (Supabase)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# AI trip planning (Claude API)
# ANTHROPIC_API_KEY=

# Payments (Stripe)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Copy this file to .env.local and fill in values for your machine.
# .env.local is git-ignored. Never commit real secrets.
#
# Variables prefixed with NEXT_PUBLIC_ are inlined into the browser bundle at
# build time. Never put secrets in a NEXT_PUBLIC_ variable.

# ---------------------------------------------------------------------------
# App (Phase 1)
# ---------------------------------------------------------------------------

# Absolute public URL of the site, no trailing slash. Used for canonical URLs,
# Open Graph metadata, robots.txt, sitemap.xml and auth email links (must be
# listed in Supabase > Authentication > URL Configuration).
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Flight data (Phase 3) - server-only, never prefix with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Which provider powers /flights: "mock" (local sample data, default) or
# "duffel" (Duffel API v2 test mode).
FLIGHTS_PROVIDER=mock

# Duffel test-mode access token, required when FLIGHTS_PROVIDER=duffel.
# Create one in the Duffel dashboard (Developers > Access tokens) with
# test mode switched on. Only tokens starting with "duffel_test_" are
# accepted; live tokens are rejected on purpose.
DUFFEL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Accounts and database (Phase 4) - Supabase
# Dashboard > Project Settings > API Keys. Leave all three empty to run the
# app without accounts (flight search keeps working).
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# PUBLISHABLE key (sb_publishable_...). Safe for the browser: Row Level
# Security protects the data. The app refuses to start if a secret key is
# put here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET key (sb_secret_...). Server-only and bypasses Row Level Security.
# Not needed yet; reserved for payment webhooks. Never prefix with
# NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# AI trip planner (Phase 5) - Claude API, server-only
# ---------------------------------------------------------------------------

# Anthropic API key (sk-ant-...) from console.anthropic.com > API Keys.
# Each generated plan is a paid API call (rate-limited per user). Leave empty
# to disable the planner. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Premium plans (Phase 6) - Stripe, TEST MODE ONLY, server-only
# Checkout is Stripe-hosted, so no publishable key is needed.
# ---------------------------------------------------------------------------

# Test secret key (sk_test_... or restricted rk_test_...) from Stripe
# Dashboard > Developers > API keys, with "Test mode" on. Live keys
# (sk_live_/rk_live_) are refused by the app in this phase.
STRIPE_SECRET_KEY=

# Price id (price_...) of the premium product. Create it with
# `npm run stripe:setup`, which prints the id to paste here.
STRIPE_PREMIUM_PRICE_ID=

# Webhook signing secret (whsec_...) for /api/webhooks/stripe: from
# `stripe listen` locally, or the endpoint's settings in the Dashboard.
STRIPE_WEBHOOK_SECRET=
